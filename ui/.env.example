# Copy to .env.local.
# Which preset in src/config/deployments.ts to run: reece-test, badkids or demo. Required for `pnpm build`
# (or use `pnpm build:reece-test` / `pnpm build:badkids`); dev falls back to reece-test.
VITE_DEPLOYMENT=reece-test
# "1" lets a production build honour ?demo in the URL (the e2e build does). Dev always does. Leave unset for a real site.
VITE_ALLOW_DEMO=
# Reown (WalletConnect) project id. Without it only injected wallets are offered.
VITE_WC_PROJECT_ID=

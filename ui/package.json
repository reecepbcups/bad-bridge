  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:reece-test": "VITE_DEPLOYMENT=reece-test VITE_ALLOW_DEMO= vite build",
    "build:badkids": "VITE_DEPLOYMENT=badkids VITE_ALLOW_DEMO= vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
